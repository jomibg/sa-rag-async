# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# Ignore all JSON files in src/results and src/dataset (and subdirectories)
src/results/**/*.json
src/result/**/*.html
src/dataset/*.json
src/dataset/**/*.json

# Force-keep the placeholder files (optional, since .gitkeep isn't matched above)
!src/results/**/.gitkeep
!src/dataset/**/.gitkeep
