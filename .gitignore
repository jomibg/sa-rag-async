# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# Ignore all JSON files in src/results and src/dataset (and subdirectories)
results/**/*.json
results/**/*.html
datasets/*.json
datasets/*.jsonl
datasets/**/*.json
datasets/**/*.jsonl

# Force-keep the placeholder files (optional, since .gitkeep isn't matched above)
!results/**/.gitkeep
!datasets/**/.gitkeep
